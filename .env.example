# Postgres (same DB as dapplepot_pipeline writes to)
POSTGRES_URL=postgresql://dapplepot:dapplepot@localhost:5432/dapplepot_pipeline

# ClickHouse (same instance)
CLICKHOUSE_HOST=your-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=dapplepot
CLICKHOUSE_PASSWORD=dapplepot

# Redis (same instance and DB as pipeline — DB 0)
REDIS_URL=redis://localhost:6379

# Auth
DAPPLEPOT_JWT_SECRET=changeme_in_production
DAPPLEPOT_JWT_ACCESS_EXPIRES_IN=15m
DAPPLEPOT_JWT_REFRESH_EXPIRES_IN=7d

# Superadmin seed - Use in prod (default - superadmin@dapplepot.dev)
# SUPERADMIN_EMAIL=you@example.com

# Google OAuth — enables "Continue with Google" on Login / Signup / Accept invite.
# Leave unset to disable Google sign-in entirely (UI hides the button).
# Set authorized redirect URI in Google Cloud Console to GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# Email (password reset + invites)
DAPPLEPOT_EMAIL_PROVIDER=console               # "console" | "smtp" | "resend"
DAPPLEPOT_EMAIL_FROM=noreply@dapplepot.io

# SMTP (only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_...

# Frontend URL (for links in emails)
DAPPLEPOT_APP_URL=http://localhost:5173

# Internal service-to-service secret (must match INTERNAL_API_SECRET in dapplepot-security)
INTERNAL_API_SECRET=changeme_in_production

# Server
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated list — e.g. https://app.dapplepot.com,https://www.dapplepot.com
API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cache TTLs (seconds)
CACHE_TTL_OVERVIEW=30
CACHE_TTL_ANALYTICS=60
CACHE_TTL_COST=300
# Security cache TTLs — aligned with dapplepot_security scorer cadence
# CACHE_TTL_SECURITY_OVERVIEW: 120s matches UI staleTime: 2min
# CACHE_TTL_SESSION_SCORE: 300s matches UI staleTime: 5min; scores are immutable once written
CACHE_TTL_SECURITY_OVERVIEW=120
CACHE_TTL_SESSION_SCORE=300
CACHE_TTL_REMEDIATION=300

# Google Cloud Storage (GCS) 
GCS_BLOG_BUCKET=dapplepot-blogs
GCS_APP_BUCKET=dapplepot-app
GCS_PROJECT_ID=your-gcp-project-id
GCS_CLIENT_EMAIL=your-service-account-email
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lemon Squeezy Store
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=
LEMONSQUEEZY_VARIANT_TEAM_MONTHLY=
LEMONSQUEEZY_VARIANT_TEAM_ANNUAL=

# Only when running in local/development mode
# DISABLE_AUTH_RATE_LIMIT=1 
